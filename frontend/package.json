{
  "name": "burrowl-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ops": "node scripts/gen-ops.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run ops && npm run typecheck && vite build",
    "dev": "npm run ops && vite build --watch",
    "e2e": "playwright test"
  },
  "dependencies": {
    "cytoscape": "3.34.2",
    "katex": "0.16.47",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/cytoscape": "3.21.9",
    "@types/node": "22.10.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "@playwright/test": "1.63.0"
  }
}
